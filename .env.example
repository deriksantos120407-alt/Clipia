NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave

# Necessário no servidor para sincronizar assinaturas e resultados.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
STRIPE_SECRET_KEY=sk_live_sua_chave
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret

# Ative somente depois que a Stripe liberar pagamentos e os links abaixo existirem.
NEXT_PUBLIC_BILLING_ENABLED=false
STRIPE_PAYMENT_LINK_BASIC=https://buy.stripe.com/seu_link_basic
STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/seu_link_pro
STRIPE_PAYMENT_LINK_AGENCY=https://buy.stripe.com/seu_link_agency

# Motor de geração de cortes. CLIP_WORKER_URL deve apontar para /jobs do worker.
CLIP_WORKER_URL=https://seu-worker.exemplo.com/jobs
CLIP_WORKER_TOKEN=gere_um_token_longo_e_aleatorio

# No serviço do worker use também:
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
# CLIP_WORKER_TOKEN=o_mesmo_token_acima
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# MAX_CONCURRENT_JOBS=1
